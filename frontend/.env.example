# Copy to .env and fill in values. Never commit .env.
# On Vercel: Project Settings → Environment Variables (same names).

# Backend API (optional — home content, etc.)
VITE_API_URL=/api

# Web3Forms — Contact page form (https://web3forms.com)
# Required in production for the contact form to send mail.
VITE_WEB3FORMS_ACCESS_KEY=your-web3forms-access-key
VITE_WEB3FORMS_TO_EMAIL=you@example.com

# Google Form — Apply / Talk to Careerly CTAs
# If unset/empty, the app falls back to the default Careerly form URL in code.
VITE_GOOGLE_FORM_URL=https://forms.gle/your-form-id
